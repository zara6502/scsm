<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0-windows</TargetFramework>
    <AssemblyName>PdnQoi</AssemblyName>
    <RootNamespace>PdnQoi</RootNamespace>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Version>1.1.0</Version>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="QoiFileType.cs" />
    <Compile Include="QoiFileTypeFactory.cs" />
    <Compile Include="SpanExtensions.cs" />
    <Compile Include="..\QoiCodecLib\QoiCodec.cs" Link="QoiCodec.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Официальный SDK Paint.NET: приносит reference-сборки PaintDotNet.*.
         Версия *-* = всегда последняя (рекомендация paintdotnet). -->
    <PackageReference Include="Paint.NET.Plugin.SDK" Version="*-*" />
  </ItemGroup>

</Project>
